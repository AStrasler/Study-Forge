# Study Forge — Environment Configuration
# Copy this file to .env and fill in values as needed.
# NEVER commit real API keys or tokens.

# ---------------------------------------------------------------------------
# Local Provider (preferred)
# ---------------------------------------------------------------------------
# Supported values for LOCAL_PROVIDER: ollama | fox | mullama
LOCAL_PROVIDER=ollama

# Model name as known by the local runtime (example for Ollama)
LOCAL_MODEL=llama3.2

# Optional: override Ollama base URL (default http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Cloud Providers (optional BYOK fallbacks)
# Leave blank / unset if you do not want to use them.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# Current Groq production model (fast). Change if you prefer another.
GROQ_MODEL=openai/gpt-oss-20b

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

GEMINI_API_KEY=

HUGGINGFACE_API_KEY=

# ---------------------------------------------------------------------------
# Provider Fallback Order (comma-separated)
# First entry should normally be the local provider.
# Example: ollama,groq,cloudflare,gemini,huggingface
# ---------------------------------------------------------------------------
PROVIDER_FALLBACK_ORDER=ollama,groq,cloudflare,gemini,huggingface

# ---------------------------------------------------------------------------
# Notion Output (optional)
# ---------------------------------------------------------------------------
NOTION_API_TOKEN=
NOTION_DATABASE_ID=

# ---------------------------------------------------------------------------
# Paths & Processing
# ---------------------------------------------------------------------------
# Folder that contains study materials to process (relative or absolute)
INPUT_FOLDER=./input

# Folder for generated study results (JSON + Markdown).
# Default is ./results — do not use ./output (that is a Python package name).
OUTPUT_FOLDER=./results

# Request timeout in seconds for provider calls.
# Local CPU models (especially Judge) often need 300+.
PROVIDER_TIMEOUT=300

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
