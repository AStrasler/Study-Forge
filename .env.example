# ============================================================================
# Study Forge — Environment Configuration
# ============================================================================
# NEVER commit this file or real API keys.
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Local Provider (preferred)
# ---------------------------------------------------------------------------
# Options: ollama, fox, mullama
LOCAL_PROVIDER=ollama
LOCAL_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Ollama Configuration
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Fox Configuration (local inference)
# ---------------------------------------------------------------------------
# Fox is a drop-in replacement for Ollama with continuous batching.
# Docs: https://fox-gpt.com
FOX_BASE_URL=http://localhost:8080
FOX_MODEL=llama3.2:3b
FOX_TIMEOUT=300

# ---------------------------------------------------------------------------
# Mullama Configuration (in-process inference)
# ---------------------------------------------------------------------------
# Mullama runs models directly inside your Python process.
# Docs: https://github.com/mullama/mullama
MULLAMA_MODEL=llama3.2:3b
MULLAMA_GPU_LAYERS=32
MULLAMA_CONTEXT_SIZE=2048
# MULLAMA_EMBEDDING_MODEL=nomic-embed

# ---------------------------------------------------------------------------
# Cloud Providers (optional BYOK fallbacks)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

GEMINI_API_KEY=

HUGGINGFACE_API_KEY=

# ---------------------------------------------------------------------------
# Provider Fallback Order
# ---------------------------------------------------------------------------
# Comma-separated list of providers in order of preference.
# Options: ollama, fox, mullama, groq, cloudflare, gemini, huggingface
PROVIDER_FALLBACK_ORDER=ollama,fox,mullama,groq,cloudflare,gemini,huggingface

# ---------------------------------------------------------------------------
# Notion Output (optional)
# ---------------------------------------------------------------------------
NOTION_API_TOKEN=
NOTION_DATABASE_ID=

# ---------------------------------------------------------------------------
# Paths & Processing
# ---------------------------------------------------------------------------
INPUT_FOLDER=./input
OUTPUT_FOLDER=./results
PROVIDER_TIMEOUT=300
LOG_LEVEL=INFO